{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrengthCandidateBundle",
  "type": "object",
  "required": ["strengths"],
  "properties": {
    "strengths": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["text", "supporting_rule_ids", "article_evidence"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "supporting_rule_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string"}
          },
          "article_evidence": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
